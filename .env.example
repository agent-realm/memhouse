# ClickHouse connection for the analytics cache. Copy to `.env` and fill in.
# Endpoint-agnostic: the same code runs against a local server, ClickHouse Cloud,
# or an embedded/kernel-hosted instance — only these values change.

# HTTP(S) interface URL. Local server default is http://localhost:8123.
CLICKHOUSE_URL=http://localhost:8123

# User with SELECT/INSERT/CREATE/DROP/TRUNCATE on the target database.
CLICKHOUSE_USER=default

# Password (empty for a default local server).
CLICKHOUSE_PASSWORD=

# Database the cache lives in (created automatically if missing).
CLICKHOUSE_DATABASE=agentlytics
