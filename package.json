{
  "name": "ultimagent-memhouse",
  "version": "0.1.0",
  "description": "mem-house — agent conversation memory across 17 editors: parse-on-client shippers, a typed ClickHouse store, kernel-agency install, and the agentlytics dashboard",
  "main": "index.js",
  "bin": {
    "agentlytics": "./index.js"
  },
  "files": [
    "index.js",
    "cache.js",
    "server.js",
    "share-image.js",
    "relay-server.js",
    "relay-client.js",
    "mcp-server.js",
    "pricing.js",
    "pricing.json",
    "editors/",
    "ui/src/",
    "ui/index.html",
    "ui/package.json",
    "ui/package-lock.json",
    "ui/vite.config.js",
    "ui/eslint.config.js",
    "public/",
    "README.md"
  ],
  "scripts": {
    "start": "node index.js",
    "build": "cd ui && npm install && npm run build",
    "dev": "cd ui && npm run dev"
  },
  "keywords": [
    "cursor",
    "devin",
    "devin-desktop",
    "claude",
    "vscode",
    "copilot",
    "zed",
    "antigravity",
    "opencode",
    "codex",
    "analytics",
    "ai",
    "agent"
  ],
  "author": "fkadev",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/f/agentlytics"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.6.2",
    "chalk": "^4.1.2",
    "express": "^4.22.1",
    "log-update": "^4.0.0",
    "open": "^8.4.2"
  }
}
