/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Markup and its styling must never outlive each other in a browser cache: a
# stale style.css against fresh HTML renders an unstyled page, and Pages' default
# for assets is an hour. Two defences, because either alone has a hole:
#
#   1. must-revalidate below, so an edit to an existing file is picked up at once.
#   2. a version suffix in the filename (style-4.css), so a copy already sitting
#      in someone's browser is never requested again. Bump the suffix on any
#      change a visitor must see immediately.
#
# Note these rules match on PATH ONLY — `/style-4.css?v=5` does NOT match
# `/style-4.css` and silently falls back to the default cache. Query-string
# cache-busting does not work here; renaming the file does.

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/style-4.css
  Cache-Control: public, max-age=0, must-revalidate

/icon-512.png
  Cache-Control: public, max-age=86400

/mark.png
  Cache-Control: public, max-age=86400

/mark-dark.png
  Cache-Control: public, max-age=86400

/lockup.png
  Cache-Control: public, max-age=86400

/lockup-dark.png
  Cache-Control: public, max-age=86400

/dashboard.png
  Cache-Control: public, max-age=86400
