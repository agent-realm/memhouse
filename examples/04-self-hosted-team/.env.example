# Copy to .env beside compose.yml and chmod 600 it: it holds the admin password.
#   cp .env.example .env && chmod 600 .env

# The name members reach the house at. DNS must point it at this machine.
MEMHOUSE_DOMAIN=memhouse.example.com
# An e-mail address gets a Let's Encrypt certificate (ports 80 and 443 must be reachable
# from the internet). `internal` uses Caddy's own CA instead — for testing, or a private
# network whose machines trust that CA.
MEMHOUSE_TLS=you@example.com

# The server's administrator. Invites members; nothing ships as it.
MEMHOUSE_ADMIN_USER=admin
# Generate one:  openssl rand -base64 24
MEMHOUSE_ADMIN_PASSWORD=

# Nightly backup, UTC, and how many to keep.
BACKUP_AT=03:17
BACKUP_KEEP=14

# Pinned versions. Read README.md "Upgrading ClickHouse" before changing CLICKHOUSE_TAG.
CLICKHOUSE_TAG=26.7.1.1315
CADDY_TAG=2.10
